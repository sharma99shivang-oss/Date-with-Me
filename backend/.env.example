SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Date With Me <you@example.com>
USER_EMAIL=

# Optional Twilio WhatsApp/SMS notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ADMIN_PHONE=
USER_PHONE=
